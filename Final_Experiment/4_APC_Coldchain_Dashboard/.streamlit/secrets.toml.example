# Streamlit AWS RDS MySQL Connection Configuration Template
# [사용 방법] 다른 컴퓨터에서 처음 프로젝트를 실행할 때:
# 1. 이 파일의 이름을 'secrets.toml'로 복사하거나 변경하세요.
# 2. MYSQL_PASSWORD에 실제 데이터베이스 비밀번호를 입력하세요.

[MySQL]
MYSQL_HOST = "labdb.cn26yq6q0mu6.ap-northeast-2.rds.amazonaws.com"
MYSQL_PORT = 3306
MYSQL_USER = "admin"
MYSQL_PASSWORD = "YOUR_DATABASE_PASSWORD_HERE"
MYSQL_DATABASE = "lab225"
