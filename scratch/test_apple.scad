// Revolve solid
module apple_solid() {
    rotate_extrude(angle=360, $fn=80) {
        polygon(concat([[0, apple_profile[0][1]]], apple_profile, [[0, apple_profile[len(apple_profile)-1][1]]]));
    }
}

// Hollow out with uniform wall thickness
module apple_shell(wall=2.8) {
    difference() {
        apple_solid();
        // Inner cavity
        scale([(87 - 2*wall)/87, (87 - 2*wall)/87, (78 - 2*wall)/78])
            apple_solid();
    }
}

// Split cut for inspection
difference() {
    color([0.85, 0.15, 0.15])
    apple_shell(wall=3.0);
    translate([0, -100, -100])
        cube([200, 200, 200]);
}

